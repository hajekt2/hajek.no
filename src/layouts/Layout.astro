---
import { ViewTransitions } from "astro:transitions";
import { SITE } from "@/config";
import "@/styles/global.css";
import Analytics from "@/components/Analytics.astro";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonicalURL?: string | URL;
  ogType?: "website" | "article";
  noindex?: boolean;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = `/${SITE.ogImage}`,
  ogImageAlt = `${SITE.title} - CCM architecture, document systems, and AI tools`,
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.website),
  ogType,
  noindex = false,
  pubDatetime,
  modDatetime,
  tags = [],
  scrollSmooth = false,
} = Astro.props;

const canonicalHref = new URL(canonicalURL, Astro.site ?? SITE.website).href;
const socialImageURL = new URL(ogImage, Astro.site ?? SITE.website).href;
const resolvedOgType = ogType ?? (pubDatetime ? "article" : "website");
const ogImageType = socialImageURL.match(/\.jpe?g(?:$|\?)/i)
  ? "image/jpeg"
  : socialImageURL.match(/\.webp(?:$|\?)/i)
    ? "image/webp"
    : "image/png";
---

<!doctype html>
<html lang={SITE.lang ?? "en"} class:list={{ "scroll-smooth": scrollSmooth }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalHref} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Article metadata -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    {resolvedOgType === "article" && <meta property="article:author" content={profile} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hajekt21" />
    <meta name="twitter:creator" content="@hajekt21" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={`${SITE.website}rss.xml`}
    />

    <meta name="theme-color" content="#006cac" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#ff6b01" media="(prefers-color-scheme: dark)" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <ViewTransitions />

    <script is:inline src="/toggle-theme.js"></script>
    
    <!-- Domain-based markdown redirect -->
    <script is:inline>
      // Check if we're on hajek.md domain
      const hostname = window.location.hostname;
      if ((hostname === 'hajek.md' || hostname === 'www.hajek.md') && !window.location.pathname.endsWith('.md')) {
        // Redirect to the .md version of the current page
        const mdPath = window.location.pathname === '/' ? '/index.md' : window.location.pathname + '.md';
        window.location.replace(mdPath + window.location.search + window.location.hash);
      }
    </script>
    
    <!-- Twitter Widget Script -->
    <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
