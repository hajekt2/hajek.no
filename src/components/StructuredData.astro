---
export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};
const readingMinutes =
  typeof data.readingTime === "string" ? Number.parseInt(data.readingTime, 10) : undefined;

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Tomas Hajek",
      url: "https://hajek.no/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Tomas Hajek",
      logo: {
        "@type": "ImageObject",
        url: "https://hajek.no/tomas-hajek-profile.png",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://hajek.no/tomas-hajek-profile.png",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    ...(readingMinutes && { timeRequired: `PT${readingMinutes}M` }),
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Tomas Hajek",
    url: "https://hajek.no",
    image: "https://hajek.no/tomas-hajek-profile.png",
    sameAs: [
      "https://github.com/hajekt2",
      "https://x.com/hajekt21",
      "https://bsky.app/profile/hajek.no",
      "https://xperconsulting.no",
      "https://ccmforge.com",
    ],
    jobTitle: "Co-founder, Managing Consultant, and Lead Architect",
    worksFor: {
      "@type": "Organization",
      name: "Xper Consulting AS",
      url: "https://xperconsulting.no",
    },
    affiliation: [
      {
        "@type": "Organization",
        name: "CCMForge",
        url: "https://ccmforge.com",
      },
    ],
    knowsAbout: [
      "Customer Communication Management",
      "Document composition",
      "OpenText Exstream",
      "Quadient Inspire",
      "PDF accessibility",
      "PDF/UA post-composition",
      "Tagged PDF generation",
      "High-performance document composition",
      "Agent-native document engineering",
      "AI-assisted document workflows",
    ],
    description:
      "CCM architecture, DocEngine, PDF/UA post-composition, high-performance document composition, AI tools, and pragmatic engineering from Norway.",
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Tomas Hajek",
    url: "https://hajek.no",
    description:
      "CCM architecture, document systems, agent-native composition, AI tools, and pragmatic engineering from Norway.",
    author: {
      "@type": "Person",
      name: "Tomas Hajek",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://hajek.no/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
