---
// Analytics component for Vercel Analytics and Speed Insights
---

<!-- Vercel Analytics -->
<script>
  if (typeof window !== 'undefined' && import.meta.env.PROD) {
    import('@vercel/analytics').then(({ inject }) => {
      inject();
    });
  }
</script>

<!-- Vercel Speed Insights -->
<script>
  if (typeof window !== 'undefined' && import.meta.env.PROD) {
    import('@vercel/speed-insights').then(({ injectSpeedInsights }) => {
      injectSpeedInsights();
    });
  }
</script>

<!-- PostHog analytics + session replay, first-party via the /signal proxy in vercel.json -->
<script>
  if (typeof window !== 'undefined' && import.meta.env.PROD) {
    let posthog = null;
    const pendingEvents = [];
    const track = (event) => {
      if (posthog) {
        posthog.capture(event);
      } else {
        pendingEvents.push(event);
      }
    };

    // The site uses Astro view transitions, so navigation is client-side page
    // swaps. Listeners are registered synchronously so the initial astro:page-load
    // is never missed regardless of when posthog-js finishes loading.
    document.addEventListener('astro:page-load', () => track('$pageview'));
    document.addEventListener('astro:before-swap', () => track('$pageleave'));

    import('posthog-js').then(({ default: instance }) => {
      instance.init('phc_sDPUcangWuAfKKG56y5WX43AAwLJhp7xnGx4xCKj4xkT', {
        api_host: 'https://hajek.no/signal',
        ui_host: 'https://eu.posthog.com',
        autocapture: true,
        capture_pageview: false,
        capture_pageleave: true,
        session_recording: { enabled: true },
      });
      posthog = instance;
      for (const event of pendingEvents.splice(0)) {
        instance.capture(event);
      }
    });
  }
</script>